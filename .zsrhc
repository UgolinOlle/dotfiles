# --- ENVIRONMENT VARIABLES ------------------------------------------------------------------------------------ #

source ~/.config/zsh/env.zsh

# --- ZSH OPTIONS ----------------------------------------------------------------------------------------------- #

# History options
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_REDUCE_BLANKS
setopt HIST_FIND_NO_DUPS
setopt EXTENDED_HISTORY
setopt HIST_VERIFY
setopt HIST_EXPIRE_DUPS_FIRST

# Directory options
setopt AUTO_PUSHD
setopt PUSHD_IGNORE_DUPS
setopt PUSHD_SILENT

# Completion options
setopt AUTO_MENU
setopt COMPLETE_IN_WORD
setopt ALWAYS_TO_END

# Correction options
setopt CORRECT
setopt CORRECT_ALL

# Key bindings
bindkey '^R' fzf-history-widget

# --- SETUP --------------------------------------------------------------------------------------------------------- #

# --- PNPM Setup
export PNPM_HOME="/Users/uolle/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# --- Git Delta
if command -v delta &>/dev/null; then
  git config --global core.pager delta
  git config --global interactive.diffFilter "delta --color-only"
  git config --global delta.navigate true
  git config --global delta.line-numbers true
  git config --global delta.side-by-side true
fi

# --- ZINIT PLUGIN MANAGER ------------------------------------------------------------------------------------- #

# Load Zinit
ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  mkdir -p "$(dirname "$ZINIT_HOME")"
  git clone https://github.com/zdharma-continuum/zinit "$ZINIT_HOME"
fi

source "${ZINIT_HOME}/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# Load plugin configuration
source ~/.config/zsh/plugins.zsh

# --- ALIASES ------------------------------------------------------------------------------------------------------- #

# --- Misc
alias cls="clear"
alias sz="source ~/.zshrc && mise doctor"
alias rm="trash"
alias grep="grep --color=auto"
alias cat="bat"
alias sshreload="eval \$(ssh-agent -s) && ssh-add -K ~/.ssh/id_rsa"
alias ports="lsof -i -P -n | grep LISTEN"
alias x="exit"
alias tp="taproom"

if command -v mise &>/dev/null; then
  eval "$(mise activate zsh)"
fi

# --- Clean
alias clean:node="rm -rf node_modules package-lock.json && npm install"
alias clean:laravel="php artisan cache:clear && php artisan config:clear && php artisan route:clear && php artisan view:clear"
alias clean:docker="docker system prune -af --volumes"

# --- Paths
alias dv="cd ~/Developer"
alias dd="cd ~/Documents"
alias dw="cd ~/Downloads"
alias wh="cd ~/Developer/whoa-studio/"
alias conf="cd ~/.config"
alias h="cd ~"
alias ..="cd .."
alias f="nvim \$(fzf --layout=reverse --border --info=inline --margin=4,20 --padding=1 --preview='batcat --color=always --style=plain {}' --style=full)"
alias fd="cd \$(fzf --layout=reverse --border --info=inline --margin=4,20 --padding=1 --preview='batcat --color=always --style=plain {}' --style=full)"

# --- List
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ll="eza --color=always --long --git --icons=always"
alias ls="eza --color=always --long --git --no-filesize --icons=always --no-user --no-permissions --no-time"

# --- Brew
alias bu="brew uninstall"
alias bi="brew install"
alias bic="brew install --cask"
alias bp="brew update && brew upgrade && brew autoremove && brew cleanup && brew doctor"
alias bs="brew services"

# --- PostgreSQL
alias pgstart="brew services start postgresql@15"
alias pgstop="brew services stop postgresql@15"
alias pgcli="psql postgres"

# --- Docker
alias d="docker"
alias ld="lazydocker"
alias da="docker start"
alias dx="docker exec -it"
alias dc="docker compose"
alias dr="docker restart"
alias dl="docker logs"
alias df="docker ps --format 'table \t{{.ID}}\t{{.Names}}\t{{.Status}}\t{{.Ports}}'"
alias drs="docker compose down && docker compose up"

# --- Git
alias g="git"
alias lg="lazygit"
alias ga="git add ."
alias gcmsg="git commit -m"
alias gco="git checkout"
alias gcb="git checkout -b"
alias glg="git log --oneline --graph --decorate"
alias gfix="git commit --amend --no-edit"

# --- Neovim
alias n="nvim"
alias nv="nvim"
alias vim="nvim"
alias vi="nvim"
alias nz="nv ~/.zshrc"
alias ns="sudo nvim"
alias nenv="nv .env"

# --- PHP Artisan (Laravel)
alias pa="php artisan"
alias pas="php artisan serve"
alias pam="php artisan migrate"
alias par="php artisan route:list"
alias pac="php artisan cache:clear"
alias pacv="php artisan config:clear && php artisan view:clear"
alias pfresh="php artisan migrate:fresh --seed"

# --- NPM
alias ni="npm install"
alias nu="npm uninstall"
alias nl="npm list"
alias nr="npm run"
alias nc="rm -rf node_modules && npm cache clean --force"
alias dev="npm run dev"
alias build="npm run build"
alias test="npm run test"
alias lint="npm run lint"

# --- PNPM
alias p="pnpm"
alias pi="pnpm install"
alias pu="pnpm update"
alias pr="pnpm run"

# --- BUN
alias b="bun"

# --- Health & Maintenance
alias zshtime="time zsh -i -c exit"
alias zshbench="for i in {1..10}; do time zsh -i -c exit; done"

# --- Disabled
# alias p10kconfig="nvim ~/.p10k.zsh && source ~/.p10k.zsh"

# --- FUNCTIONS ----------------------------------------------------------------------------------------------------- #

# --- CD into a specific folder
function cdf() {
  local dir
  dir=$(fd --type d . ~ | fzf) && cd "$dir"
}

# --- Create an .env file from a template
function envcopy() {
  if [ ! -f ".env.example" ]; then
    echo "❌ .env.example not found"
    return 1
  fi
  cp .env.example .env && echo "✅ .env copied"
}

# --- Restart GPG agent
function rgpg() {
  gpgconf --kill gpg-agent
  gpgconf --launch gpg-agent
}

# --- Find running process
function fproc() {
  if [ -z "$1" ]; then
    echo "Usage: find_process <keyword>"
    return 1
  fi
  ps aux | grep "$1" | grep -v "grep"
}

# --- Check an URL
function ckurl() {
  if [ -z "$1" ]; then
    echo "Usage: check_url <url>"
    return 1
  fi
  curl -Is "$1" | head -n 1
}

# --- Compress a folder / file
function compress() {
  if [ -z "$1" ] || [ -z "$2" ]; then
    echo "Usage: compress <source-folder> <destination-archive>"
    return 1
  fi
  tar -czvf "$2".tar.gz "$1"
  echo "Folder $1 compressed into $2.tar.gz"
}

# --- Uncompress a folder / file
function decompress() {
  if [ -z "$1" ]; then
    echo "Usage: decompress <archive-file>"
    return 1
  fi
  tar -xzvf "$1"
  echo "Archive $1 decompressed."
}

# --- Kill a process from a number
function kport() {
  if [ -z "$1" ]; then
    echo "Usage: kport <port-number>"
    return 1
  fi
  lsof -ti :"$1" | xargs kill -9
}

# --- Generate password
function randpw() {
  openssl rand -base64 4 | md5 | head -c$1 ; echo
}

# --- Generate sha256
function sha256() {
    printf "%s %s\n" "$1" "$2" | sha256sum --check
}

# --- Dotfiles management
function dotfiles() {
  local action="${1:-status}"
  case "$action" in
    "edit" | "e")
      cd ~/.config && $EDITOR .
      ;;
    "status" | "s")
      cd ~/.config && git status
      ;;
    "sync" | "pull")
      cd ~/.config && git pull && echo "✅ Dotfiles synced"
      ;;
    "backup" | "push")
      cd ~/.config && git add . && git commit -m "Update dotfiles $(date +%Y-%m-%d)" && git push
      ;;
    *)
      echo "Usage: dotfiles [edit|status|sync|backup]"
      ;;
  esac
}

# --- Project navigation with fzf
function proj() {
  local dir
  dir=$(fd --type d --max-depth 2 . ~/Developer | fzf --preview="eza -la {}" --height=40%) && cd "$dir"
}

# --- Smart mkdir and cd
function mkcd() {
  mkdir -p "$1" && cd "$1"
}

# --- Create project from template
function newproj() {
  local template="$1"
  local project_name="$2"
  
  if [[ -z "$template" || -z "$project_name" ]]; then
    echo "Usage: newproj <template> <project_name>"
    echo "Available templates:"
    ls ~/Developer/.templates/
    return 1
  fi
  
  local template_path="~/Developer/.templates/$template"
  local project_path="~/Developer/$project_name"
  
  if [[ ! -d "$template_path" ]]; then
    echo "❌ Template '$template' not found"
    return 1
  fi
  
  if [[ -d "$project_path" ]]; then
    echo "❌ Project '$project_name' already exists"
    return 1
  fi
  
  echo "📁 Creating project '$project_name' from template '$template'..."
  cp -r "$template_path" "$project_path"
  cd "$project_path"
  
  # Replace PROJECT_NAME placeholder in files
  if command -v sed &>/dev/null; then
    find . -type f -name "*.json" -o -name "*.toml" -o -name "*.md" | \
      xargs sed -i "" "s/PROJECT_NAME/$project_name/g" 2>/dev/null || true
  fi
  
  # Initialize git repository
  git init
  echo "✅ Project '$project_name' created successfully!"
  echo "📍 Location: $(pwd)"
}

# --- COMPLETIONS ---------------------------------------------------------------------------------------------------- #

# --- Global completion
fpath=(~/.zsh/completions $fpath)

# --- Ngrok completion
if command -v ngrok &>/dev/null; then
  eval "$(ngrok completion)"
fi

# --- MISCELLANEOUS -------------------------------------------------------------------------------------------------- #

# --- Sources
eval "$(rbenv init -)"
eval "$(starship init zsh)"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Added by LM Studio CLI (lms)
export PATH="$PATH:/Users/uolle/.lmstudio/bin"
