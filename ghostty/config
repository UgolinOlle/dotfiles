font-family = "JetBrainsMonoNL NFM Regular"
font-family = "Symbols Nerd Font Mono"
font-family-bold = "JetBrainsMonoNL NFM Bold"
font-family-italic = "JetBrainsMonoNL NFM Italic"
font-family-bold-italic = "JetBrainsMonoNL NFM Bold Italic"

font-feature = calt
font-feature = liga
font-feature = ss13

font-size = 13
font-thicken = true

window-inherit-font-size = true

# Look and Feel
adjust-cursor-thickness = 3
adjust-underline-position = 40%
adjust-underline-thickness = -60%
adjust-cell-height = 35%
bold-is-bright = true
cursor-style = block
cursor-style-blink = false
cursor-invert-fg-bg = true
link-url = true
mouse-hide-while-typing = true
window-vsync = true
background-opacity = 0.8
background-blur = true
window-padding-x = 20
window-padding-y = 20
macos-titlebar-style = "transparent"
window-theme = "auto"
window-save-state = always
window-colorspace = display-p3
mouse-scroll-multiplier = 2

# Other
initial-command = /opt/homebrew/bin/zellij
clipboard-paste-protection = true
clipboard-trim-trailing-spaces = true
copy-on-select = clipboard
macos-auto-secure-input = true
macos-secure-input-indication = true
macos-option-as-alt = left
quit-after-last-window-closed = true
scrollback-limit = 4200
shell-integration-features = cursor,sudo,title
confirm-close-surface = false

# Themes
theme = dark:Vercel,light:Github Light Default

keybind = alt+left=unbind
keybind = alt+right=unbind
keybind = cmd+s>r=reload_config
