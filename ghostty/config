font-family                    = Symbols Nerd Font Mono
font-family                    = PragmataPro Liga
font-family-bold               = PragmataPro Liga
font-family-italic             = PragmataPro Liga
font-family-bold-italic        = PragmataPro Liga

font-feature                   = calt
font-feature                   = liga
font-feature                   = ss13

font-size                      = 12
window-inherit-font-size       = true

# Look and Feel
adjust-cursor-thickness        = 3
adjust-underline-position      = 3
bold-is-bright                 = true
cursor-invert-fg-bg            = true
cursor-opacity                 = 0.8
link-url                       = true
mouse-hide-while-typing        = true
window-vsync                   = true
background-opacity             = 0.8
background-blur                = true
window-padding-x               = 20
window-padding-y               = 20
macos-titlebar-style           = "transparent"

# Other
clipboard-paste-protection     = true
clipboard-trim-trailing-spaces = true
copy-on-select                 = true
macos-auto-secure-input        = true
macos-secure-input-indication  = true
macos-option-as-alt            = left
quit-after-last-window-closed  = true
scrollback-limit               = 4200
shell-integration              = fish
shell-integration-features     = cursor,sudo,title

# Vercel-inspired theme colors
background                   = 000000
foreground                   = fafbfc
cursor-color                 = fafbfc
selection-background         = 333333
selection-foreground         = fafbfc

# Terminal color palette (Vercel/Geist inspired)
palette = 0=#000000
palette = 1=#ff6b6b
palette = 2=#7ce0c3
palette = 3=#ffd93d
palette = 4=#54a6f8
palette = 5=#e43ade
palette = 6=#7ce0c3
palette = 7=#fafbfc
palette = 8=#888888
palette = 9=#ff6b6b
palette = 10=#7ce0c3
palette = 11=#ffd93d
palette = 12=#54a6f8
palette = 13=#e43ade
palette = 14=#7ce0c3
palette = 15=#fafbfc

keybind = alt+left=unbind
keybind = alt+right=unbind
