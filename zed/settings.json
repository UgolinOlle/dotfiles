{
	// ===========================
	// THEME & APPEARANCE
	// ===========================
	"session": {
  "trust_all_worktrees": true
 },
 "preview_tabs": {
  "enabled": false,
  "enable_preview_from_file_finder": false
 },
 "lsp_document_links": false,
 "show_signature_help_after_edits": false,
 "multi_cursor_modifier": "cmd_or_ctrl",
 "sticky_scroll": {
  "enabled": false
 },
 "hover_popover_sticky": true,
 "hover_popover_delay": 1500,
 "selection_highlight": false,
 "window_title_format": "${projectName}",
 "fullscreen_mode": "native",
 "use_system_window_tabs": false,
 "max_tabs": 5,
 "use_system_path_prompts": false,
 "buffer_font_fallbacks": [
  "Fira Code",
  "Consolas",
  "monospace"
 ],
 "file_types": {
  "json": [
   ".prettierrc"
  ],
  "dotenv": [
   ".env.*",
   ".dev.vars"
  ],
  "jsonl": [
   "*.ndjson"
  ],
  "css": [
   "*.css"
  ]
 },
 "colorize_brackets": false,
 "auto_indent_on_paste": true,
 "linked_edits": true,
 "use_on_type_format": true,
 "show_whitespaces": "selection",
 "show_edit_predictions": true,
 "semantic_tokens": "off",
 "line_ending": "prefer_lf",
 "ensure_final_newline_on_save": true,
 "wrap_guides": [
  120
 ],
 "preferred_line_length": 120,
 "base_keymap": "VSCode",
 "agent_servers": {
  "claude-acp": {
   "type": "registry"
  },
  "github-copilot-cli": {
   "type": "registry"
  }
 },
 "prettier": {
		"allowed": true,
	},
	"ui_font_weight": 500,
	"theme": {
		"mode": "system",
		"light": "VSCode Light Modern",
		"dark": "VSCode Dark Modern",
	},
	"icon_theme": {
		"light": "Material Icon Theme",
		"dark": "JetBrains New UI Icons (Dark)",
	},

	// ===========================
	// FONTS & TYPOGRAPHY
	// ===========================
	"ui_font_family": "JetBrainsMono Nerd Font",
	"ui_font_size": 14,
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_size": 13.5,
	"buffer_font_weight": 500,
	"buffer_line_height": "comfortable",
	"buffer_font_features": {
		"calt": true,
		"liga": true,
	},
	"line_indicator_format": "long",

	// ===========================
	// EDITOR BEHAVIOR
	// ===========================
	"vim_mode": true,
	"cursor_blink": true,
	"relative_line_numbers": "disabled",
	"vertical_scroll_margin": 8,
	"scroll_beyond_last_line": "off",
	"soft_wrap": "prefer_line",
	"use_smartcase_search": true,
	"auto_signature_help": false,
	"hide_mouse": "on_typing_and_movement",

	// ===========================
	// FORMATTING & INDENTATION
	// ===========================
	"hard_tabs": false,
	"tab_size": 4,
	"format_on_save": "on",
	"formatter": "prettier",

	// ===========================
	// AUTOSAVE
	// ===========================
	"autosave": {
		"after_delay": {
			"milliseconds": 1000,
		},
	},

	// ===========================
	// VISUAL GUIDES & HINTS
	// ===========================
	"indent_guides": {
		"coloring": "indent_aware",
		"enabled": false,
	},
	"inlay_hints": {
		"enabled": true,
		"show_type_hints": true,
		"show_parameter_hints": true,
		"show_other_hints": true,
		"show_background": false,
		"edit_debounce_ms": 700,
		"scroll_debounce_ms": 50,
		"toggle_on_modifiers_press": null,
	},
	"lsp_document_colors": "border",

	// ===========================
	// SCROLLBAR & MINIMAP
	// ===========================
	"scrollbar": {
		"axes": {
   "horizontal": false,
   "vertical": false
  },
  "show": "never",
		"cursors": false,
		"git_diff": true,
		"search_results": true,
		"selected_symbol": true,
		"diagnostics": "all",
	},
	"minimap": {
		"current_line_highlight": null,
		"display_in": "active_editor",
		"max_width_columns": 80,
		"show": "never",
		"thumb": "always",
		"thumb_border": "left_open",
	},

	// ===========================
	// TOOLBAR & UI ELEMENTS
	// ===========================
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": false,
	},
	"tab_bar": {
		"show": true,
		"show_nav_history_buttons": false,
		"show_tab_bar_buttons": false,
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "all",
		"activate_on_close": "neighbour",
		"show_close_button": "hover",
	},
	"vim": {
		"use_system_clipboard": "always",
	},
	"title_bar": {
		"show_branch_icon": true,
		"show_branch_name": true,
		"show_onboarding_banner": false,
		"show_project_items": true,
		"show_user_picture": false,
	},
	"status_bar": {
		"experimental.show": true,
	},
	"gutter": {
		"line_numbers": true,
		"folds": false,
		"runnables": false,
		"breakpoints": true,
	},

	// ===========================
	// PANELS & SIDEBARS
	// ===========================
	"project_panel": {
		"hide_gitignore": true,
		"indent_size": 16,
		"default_width": 350,
		"button": true,
		"git_status": true,
		"dock": "left",
		"auto_reveal_entries": false,
		"auto_fold_dirs": false,
		"sticky_scroll": true,
		"drag_and_drop": true,
		"show_diagnostics": "all",
		"scrollbar": {
			"show": null,
		},
	},
	"git_panel": {
		"button": true,
		"dock": "right",
		"default_width": 360,
		"status_style": "icon",
	},
	"collaboration_panel": {
		"button": false,
		"dock": "right",
	},
	"notification_panel": {
		"button": true,
		"dock": "right",
	},
	"outline_panel": {
		"button": true,
		"dock": "left",
		"default_width": 300,
		"file_icons": true,
		"folder_icons": true,
		"git_status": true,
		"indent_size": 20,
		"indent_guides": {
			"show": "always",
		},
		"auto_reveal_entries": true,
	},
	"diagnostics": {
		"button": true,
		"include_warnings": false,
		"inline": {
			"enabled": true,
		},
	},
	"debugger": {
		"button": false,
		"dock": "bottom",
	},
	"search": {
		"button": false,
	},

	// ===========================
	// TERMINAL
	// ===========================
	"terminal": {
		"toolbar": {
			"breadcrumbs": false,
		},
		"copy_on_select": true,
		"shell": "system",
		"button": false,
		"blinking": "on",
		"cursor_shape": "block",
		"dock": "bottom",
		"default_width": 200,
		"font_family": "JetBrainsMono Nerd Font",
		"font_weight": 500,
		"font_size": 14,
		"line_height": {
   "custom": 1.2
  },
	},

	// ===========================
	// AI AGENT
	// ===========================
	"agent": {
		"button": false,
		"always_allow_tool_actions": true,
		"dock": "right",
		"default_profile": "write",
		"default_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4",
		},
	},

	// ===========================
	// GIT
	// ===========================
	"git": {
		"git_gutter": "tracked_files",
		"inline_blame": {
			"enabled": true,
			"show_commit_summary": true,
			"padding": 7,
		},
		"branch_picker": {
			"show_author_name": true,
		},
		"hunk_style": "unstaged_hollow",
	},

	// ===========================
	// LANGUAGE SERVERS (LSP)
	// ===========================
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": ["class", "className", "ngClass", "styles"],
			},
		},
	},

	// ===========================
	// CONTEXT SERVERS (MCP)
	// ===========================
	"context_servers": {
		"postgres-context-server": {
			"enabled": true,
			"settings": {
				"database_url": "postgresql://postgres:postgres@postgres:5432",
			},
		},
		"github-activity-summarizer": {
			"enabled": true,
			"settings": {},
		},
	},

	// ===========================
	// LANGUAGE-SPECIFIC SETTINGS
	// ===========================
	"languages": {
		"JSON": {
			"colorize_brackets": false,
   "auto_indent_on_paste": true,
   "linked_edits": true,
   "use_on_type_format": true,
   "show_whitespaces": "selection",
   "show_edit_predictions": true,
   "semantic_tokens": "off",
   "line_ending": "prefer_lf",
   "ensure_final_newline_on_save": true,
   "indent_guides": {
    "enabled": false
   },
   "wrap_guides": [
    120
   ],
   "preferred_line_length": 120,
   "soft_wrap": "prefer_line",
   "hard_tabs": false,
   "tab_size": 4,
   "formatter": "prettier",
			"format_on_save": "on",
		},
		"Markdown": {
			"colorize_brackets": false,
   "auto_indent_on_paste": true,
   "linked_edits": true,
   "use_on_type_format": true,
   "show_whitespaces": "selection",
   "show_edit_predictions": true,
   "semantic_tokens": "off",
   "line_ending": "prefer_lf",
   "ensure_final_newline_on_save": true,
   "indent_guides": {
    "enabled": false
   },
   "wrap_guides": [
    120
   ],
   "tab_size": 4,
   "hard_tabs": false,
			"preferred_line_length": 120,
			"soft_wrap": "prefer_line",
			"formatter": "prettier",
			"format_on_save": "on",
		},
		"TSX": {
			"colorize_brackets": false,
   "auto_indent_on_paste": true,
   "linked_edits": true,
   "use_on_type_format": true,
   "show_whitespaces": "selection",
   "show_edit_predictions": true,
   "semantic_tokens": "off",
   "line_ending": "prefer_lf",
   "ensure_final_newline_on_save": true,
   "indent_guides": {
    "enabled": false
   },
   "wrap_guides": [
    120
   ],
   "preferred_line_length": 120,
   "soft_wrap": "prefer_line",
   "hard_tabs": false,
   "tab_size": 4,
   "inlay_hints": {
				"show_type_hints": false,
				"show_other_hints": false,
			},
			"formatter": "prettier",
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true,
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."],
		},
		"TypeScript": {
			"colorize_brackets": false,
   "auto_indent_on_paste": true,
   "linked_edits": true,
   "use_on_type_format": true,
   "show_whitespaces": "selection",
   "show_edit_predictions": true,
   "semantic_tokens": "off",
   "line_ending": "prefer_lf",
   "ensure_final_newline_on_save": true,
   "indent_guides": {
    "enabled": false
   },
   "wrap_guides": [
    120
   ],
   "preferred_line_length": 120,
   "soft_wrap": "prefer_line",
   "hard_tabs": false,
   "tab_size": 4,
   "formatter": "prettier",
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true,
			},
			"inlay_hints": {
				"show_type_hints": false,
				"show_other_hints": false,
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."],
		},
		"YAML": {
			"colorize_brackets": false,
   "auto_indent_on_paste": true,
   "linked_edits": true,
   "use_on_type_format": true,
   "show_whitespaces": "selection",
   "show_edit_predictions": true,
   "semantic_tokens": "off",
   "line_ending": "prefer_lf",
   "ensure_final_newline_on_save": true,
   "format_on_save": "on",
   "indent_guides": {
    "enabled": false
   },
   "wrap_guides": [
    120
   ],
   "preferred_line_length": 120,
   "soft_wrap": "prefer_line",
   "tab_size": 4,
   "hard_tabs": false,
		},
	},

	// ===========================
	// FILE SCANNING
	// ===========================
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/out",
		"**/dist",
		"**/.husky",
		"**/.turbo",
		"**/.vscode-test",
		"**/.vscode",
		"**/.next",
		"**/.storybook",
		"**/.tap",
		"**/.nyc_output",
		"**/report",
		"**/node_modules",
	],

	// ===========================
	// FEATURES & EXPERIMENTAL
	// ===========================
	"features": {
		"edit_prediction_provider": "zed",
	},
	"experimental.theme_overrides": {
		"background.appearance": "blurred",
	},

	// ===========================
	// SYSTEM & TELEMETRY
	// ===========================
	"restore_on_startup": "launchpad",
	"telemetry": {
		"diagnostics": true,
		"metrics": true,
	},
}
