{
	// ===========================
	// THEME & APPEARANCE
	// ===========================
	"theme": {
		"mode": "system",
		"light": "Vercel Light",
		"dark": "Vercel Dark"
	},
	"icon_theme": {
		"light": "Colored Zed Icons Theme Light",
		"dark": "Colored Zed Icons Theme Dark"
	},
	"experimental.theme_overrides": {
		"panel.focused_border": "#FF0000"
	},

	// ===========================
	// FONTS & TYPOGRAPHY
	// ===========================
	"ui_font_family": "JetBrainsMono Nerd Font",
	"ui_font_size": 14,
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_size": 13,
	"buffer_font_weight": 500,
	"buffer_line_height": {
		"custom": 1.8
	},

	// ===========================
	// EDITOR BEHAVIOR
	// ===========================
	"vim_mode": true,
	"cursor_blink": true,
	"relative_line_numbers": true,
	"vertical_scroll_margin": 8,
	"scroll_beyond_last_line": "off",
	"soft_wrap": "editor_width",
	"use_smartcase_search": true,
	"auto_signature_help": true,

	// ===========================
	// FORMATTING & INDENTATION
	// ===========================
	"hard_tabs": true,
	"tab_size": 2,
	"format_on_save": "on",
	"formatter": "prettier",

	// ===========================
	// AUTOSAVE
	// ===========================
	"autosave": {
		"after_delay": {
			"milliseconds": 500
		}
	},

	// ===========================
	// VISUAL GUIDES & HINTS
	// ===========================
	"indent_guides": {
		"coloring": "indent_aware",
		"enabled": true
	},
	"inlay_hints": {
		"enabled": true,
		"show_other_hints": true,
		"show_parameter_hints": true,
		"show_type_hints": true
	},
	"lsp_document_colors": "border",

	// ===========================
	// SCROLLBAR & MINIMAP
	// ===========================
	"scrollbar": {
		"show": "never"
	},
	"minimap": {
		"current_line_highlight": null,
		"display_in": "active_editor",
		"max_width_columns": 80,
		"show": "auto",
		"thumb": "always",
		"thumb_border": "left_open"
	},

	// ===========================
	// TOOLBAR & UI ELEMENTS
	// ===========================
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": false
	},
	"tab_bar": {
		"show": true,
		"show_nav_history_buttons": false,
		"show_tab_bar_buttons": false
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "errors"
	},
	"title_bar": {
		"show_branch_icon": true,
		"show_branch_name": true,
		"show_onboarding_banner": false,
		"show_project_items": true,
		"show_user_picture": false
	},

	// ===========================
	// PANELS & SIDEBARS
	// ===========================
	"project_panel": {
		"hide_gitignore": true,
		"indent_size": 16,
		"auto_fold_dirs": false,
		"default_width": 350,
		"button": false,
		"dock": "left"
	},
	"git_panel": {
		"button": true,
		"dock": "left"
	},
	"collaboration_panel": {
		"button": false,
		"dock": "left"
	},
	"notification_panel": {
		"button": false,
		"dock": "left"
	},
	"outline_panel": {
		"button": true,
		"dock": "right"
	},
	"diagnostics": {
		"button": false,
		"include_warnings": false
	},
	"debugger": {
		"button": false
	},
	"search": {
		"button": false
	},

	// ===========================
	// TERMINAL
	// ===========================
	"terminal": {
		"toolbar": {
			"breadcrumbs": false
		},
		"button": false,
		"blinking": "on",
		"cursor_shape": "bar",
		"default_height": 1000,
		"font_family": "JetBrainsMono Nerd Font Mono",
		"font_weight": 300,
		"line_height": "standard",
		"font_size": 14,
		"shell": "system"
	},

	// ===========================
	// AI AGENT
	// ===========================
	"agent": {
		"button": false,
		"always_allow_tool_actions": true,
		"dock": "left",
		"default_model": {
			"model": "gpt-4.1",
			"provider": "copilot_chat"
		},
		"default_profile": "write"
	},

	// ===========================
	// GIT
	// ===========================
	"git": {
		"git_gutter": "tracked_files"
	},

	// ===========================
	// LANGUAGE SERVERS (LSP)
	// ===========================
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": ["class", "className", "ngClass", "styles"]
			}
		}
	},

	// ===========================
	// LANGUAGE-SPECIFIC SETTINGS
	// ===========================
	"languages": {
		"Markdown": {
			"hard_tabs": false,
			"preferred_line_length": 80,
			"soft_wrap": "preferred_line_length"
		},
		"TSX": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."]
		},
		"TypeScript": {
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true
			},
			"inlay_hints": {
				"enabled": true
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."]
		},
		"YAML": {
			"hard_tabs": false
		}
	},

	// ===========================
	// FILE SCANNING
	// ===========================
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/out",
		"**/dist",
		"**/.husky",
		"**/.turbo",
		"**/.vscode-test",
		"**/.vscode",
		"**/.next",
		"**/.storybook",
		"**/.tap",
		"**/.nyc_output",
		"**/report",
		"**/node_modules"
	],

	// ===========================
	// FEATURES & EXPERIMENTAL
	// ===========================
	"features": {
		"edit_prediction_provider": "zed"
	},

	// ===========================
	// SYSTEM & TELEMETRY
	// ===========================
	"restore_on_startup": "none",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	}
}
