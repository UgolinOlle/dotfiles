{
	// ===========================
	// THEME & APPEARANCE
	// ===========================
	"theme": {
		"mode": "system",
		"light": "Vercel Light",
		"dark": "Vercel Dark"
	},
	"icon_theme": {
		"light": "Colored Zed Icons Theme Light",
		"dark": "Colored Zed Icons Theme Dark"
	},

	// ===========================
	// FONTS & TYPOGRAPHY
	// ===========================
	"ui_font_family": "JetBrainsMono Nerd Font",
	"ui_font_size": 14,
	"buffer_font_family": "JetBrainsMono Nerd Font",
	"buffer_font_size": 13,
	"buffer_font_weight": 500,
	"buffer_line_height": {
		"custom": 2
	},
	"buffer_font_features": {
		"calt": true,
		"liga": true
	},
	"line_indicator_format": "long",

	// ===========================
	// EDITOR BEHAVIOR
	// ===========================
	"vim_mode": true,
	"cursor_blink": true,
	"relative_line_numbers": true,
	"vertical_scroll_margin": 8,
	"scroll_beyond_last_line": "off",
	"soft_wrap": "editor_width",
	"use_smartcase_search": true,
	"auto_signature_help": true,
	"hide_mouse": "on_typing_and_movement",

	// ===========================
	// FORMATTING & INDENTATION
	// ===========================
	"hard_tabs": true,
	"tab_size": 2,
	"format_on_save": "on",
	"formatter": "prettier",

	// ===========================
	// AUTOSAVE
	// ===========================
	"autosave": {
		"after_delay": {
			"milliseconds": 500
		}
	},

	// ===========================
	// VISUAL GUIDES & HINTS
	// ===========================
	"indent_guides": {
		"coloring": "indent_aware",
		"enabled": true
	},
	"inlay_hints": {
		"enabled": true,
		"show_type_hints": true,
		"show_parameter_hints": true,
		"show_other_hints": true,
		"show_background": false,
		"edit_debounce_ms": 700,
		"scroll_debounce_ms": 50,
		"toggle_on_modifiers_press": null
	},
	"lsp_document_colors": "border",

	// ===========================
	// SCROLLBAR & MINIMAP
	// ===========================
	"scrollbar": {
		"show": "never",
		"cursors": false,
		"git_diff": true,
		"search_results": true,
		"selected_symbol": true,
		"diagnostics": "all"
	},
	"minimap": {
		"current_line_highlight": null,
		"display_in": "active_editor",
		"max_width_columns": 80,
		"show": "auto",
		"thumb": "always",
		"thumb_border": "left_open"
	},

	// ===========================
	// TOOLBAR & UI ELEMENTS
	// ===========================
	"toolbar": {
		"breadcrumbs": false,
		"quick_actions": false
	},
	"tab_bar": {
		"show": true,
		"show_nav_history_buttons": false,
		"show_tab_bar_buttons": false
	},
	"tabs": {
		"file_icons": true,
		"git_status": true,
		"show_diagnostics": "all",
		"activate_on_close": "neighbour",
		"show_close_button": "hover"
	},
	"title_bar": {
		"show_branch_icon": true,
		"show_branch_name": true,
		"show_onboarding_banner": false,
		"show_project_items": true,
		"show_user_picture": false
	},
	"gutter": {
		"line_numbers": true,
		"folds": false,
		"runnables": false,
		"breakpoints": true
	},

	// ===========================
	// PANELS & SIDEBARS
	// ===========================
	"project_panel": {
		"hide_gitignore": true,
		"indent_size": 16,
		"default_width": 350,
		"button": true,
		"git_status": true,
		"dock": "right",
		"auto_reveal_entries": true,
		"auto_fold_dirs": true,
		"sticky_scroll": true,
		"drag_and_drop": true,
		"show_diagnostics": "all",
		"scrollbar": {
			"show": null
		}
	},
	"git_panel": {
		"button": true,
		"dock": "left",
		"default_width": 360,
		"status_style": "icon"
	},
	"collaboration_panel": {
		"button": false,
		"dock": "right"
	},
	"notification_panel": {
		"button": false,
		"dock": "left"
	},
	"outline_panel": {
		"button": false,
		"dock": "right",
		"default_width": 300,
		"file_icons": true,
		"folder_icons": true,
		"git_status": true,
		"indent_size": 20,
		"indent_guides": {
			"show": "always"
		},
		"auto_reveal_entries": true
	},
	"diagnostics": {
		"button": false,
		"include_warnings": false,
		"inline": {
			"enabled": true
		}
	},
	"debugger": {
		"button": false,
		"dock": "bottom"
	},
	"search": {
		"button": false
	},

	// ===========================
	// TERMINAL
	// ===========================
	"terminal": {
		"toolbar": {
			"breadcrumbs": false
		},
		"copy_on_select": true,
		"shell": "system",
		"button": false,
		"blinking": "on",
		"cursor_shape": "bar",
		"dock": "bottom",
		"default_width": 200,
		"font_family": "JetBrainsMono Nerd Font Mono",
		"font_weight": 500,
		"font_size": 14,
		"line_height": "standard"
	},

	// ===========================
	// AI AGENT
	// ===========================
	"agent": {
		"button": false,
		"always_allow_tool_actions": true,
		"preferred_completion_mode": "normal",
		"dock": "right",
		"default_profile": "write",
		"default_model": {
			"provider": "zed.dev",
			"model": "claude-sonnet-4"
		}
	},

	// ===========================
	// GIT
	// ===========================
	"git": {
		"git_gutter": "tracked_files",
		"inline_blame": {
			"enabled": true,
			"show_commit_summary": true,
			"padding": 7
		},
		"branch_picker": {
			"show_author_name": true
		},
		"hunk_style": "unstaged_hollow"
	},

	// ===========================
	// LANGUAGE SERVERS (LSP)
	// ===========================
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": ["class", "className", "ngClass", "styles"]
			}
		}
	},

	// ===========================
	// CONTEXT SERVERS (MCP)
	// ===========================
	"context_servers": {
		"postgres-context-server": {
			"source": "extension",
			"enabled": true,
			"settings": {
				"database_url": "postgresql://postgres:postgres@postgres:5432"
			}
		},
		"github-activity-summarizer": {
			"source": "extension",
			"enabled": true,
			"settings": {}
		}
	},

	// ===========================
	// LANGUAGE-SPECIFIC SETTINGS
	// ===========================
	"languages": {
		"JSON": {
			"formatter": "prettier",
			"format_on_save": "on"
		},
		"Markdown": {
			"hard_tabs": false,
			"preferred_line_length": 80,
			"soft_wrap": "preferred_line_length",
			"formatter": "prettier",
			"format_on_save": "on"
		},
		"TSX": {
			"formatter": "prettier",
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."]
		},
		"TypeScript": {
			"formatter": "prettier",
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.eslint": true,
				"source.organizeImports": true
			},
			"inlay_hints": {
				"enabled": true
			},
			"language_servers": ["typescript-language-server", "!vtsls", "..."]
		},
		"YAML": {
			"hard_tabs": false
		}
	},

	// ===========================
	// FILE SCANNING
	// ===========================
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings",
		"**/out",
		"**/dist",
		"**/.husky",
		"**/.turbo",
		"**/.vscode-test",
		"**/.vscode",
		"**/.next",
		"**/.storybook",
		"**/.tap",
		"**/.nyc_output",
		"**/report",
		"**/node_modules"
	],

	// ===========================
	// FEATURES & EXPERIMENTAL
	// ===========================
	"features": {
		"edit_prediction_provider": "zed"
	},
	"experimental.theme_overrides": {
		"background.appearance": "blurred"
	},

	// ===========================
	// SYSTEM & TELEMETRY
	// ===========================
	"restore_on_startup": "none",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	}
}
